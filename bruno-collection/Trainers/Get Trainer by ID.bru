meta {
  name: Get Trainer by ID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/trainers/1
  body: none
  auth: none
}

docs {
  Récupère les détails d'un dresseur spécifique par son ID.

  ### Paramètres
  - id: ID du dresseur

  ### Réponse attendue
  - Status: 200 OK
  - Body: TrainerDto
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response has trainer data", function() {
    const trainer = res.getBody();
    expect(trainer).to.have.property('id');
    expect(trainer).to.have.property('name');
    expect(trainer).to.have.property('avatarUrl');
    expect(trainer).to.have.property('description');
    expect(trainer).to.have.property('age');
    expect(trainer).to.have.property('hometown');
    expect(trainer).to.have.property('level');
  });

  test("Trainer ID matches request", function() {
    const trainer = res.getBody();
    expect(trainer.id).to.equal(1);
  });

  test("Trainer name is not empty", function() {
    const trainer = res.getBody();
    expect(trainer.name).to.be.a('string');
    expect(trainer.name.length).to.be.greaterThan(0);
  });

  test("Avatar URL is valid", function() {
    const trainer = res.getBody();
    expect(trainer.avatarUrl).to.be.a('string');
    expect(trainer.avatarUrl).to.match(/^https?:\/\//);
  });

  test("Age is within valid range", function() {
    const trainer = res.getBody();
    expect(trainer.age).to.be.a('number');
    expect(trainer.age).to.be.at.least(5);
    expect(trainer.age).to.be.at.most(100);
  });

  test("Hometown is not empty", function() {
    const trainer = res.getBody();
    expect(trainer.hometown).to.be.a('string');
    expect(trainer.hometown.length).to.be.greaterThan(0);
  });

  test("Level is valid", function() {
    const trainer = res.getBody();
    const validLevels = ['beginner', 'intermediate', 'advanced', 'master'];
    expect(validLevels).to.include(trainer.level);
  });

  test("FavoritePokemon is valid if present", function() {
    const trainer = res.getBody();
    if (trainer.favoritePokemon !== undefined && trainer.favoritePokemon !== null) {
      expect(trainer.favoritePokemon).to.be.a('number');
      expect(trainer.favoritePokemon).to.be.greaterThan(0);
    }
  });
}

