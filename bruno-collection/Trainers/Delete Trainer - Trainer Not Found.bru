meta {
  name: Delete Trainer - Trainer Not Found
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}/trainers/99999
  body: none
  auth: none
}

docs {
  Test du cas d'erreur 404 lorsqu'on supprime un dresseur inexistant.

  ### Paramètres
  - id: ID inexistant (99999)

  ### Réponse attendue
  - Status: 404 Not Found
  - Message: Erreur indiquant que le dresseur n'existe pas
}

tests {
  test("Status code is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("Error message is present", function() {
    const body = res.getBody();
    expect(body).to.have.property('message');
  });

  test("Error indicates not found", function() {
    const body = res.getBody();
    expect(body.message).to.match(/trouv/i);
  });
}
