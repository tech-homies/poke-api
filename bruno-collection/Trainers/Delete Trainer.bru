meta {
  name: Delete Trainer
  type: http
  seq: 8
}

delete {
  url: {{baseUrl}}/trainers/1
  body: none
  auth: none
}

docs {
  Supprime un dresseur par son ID.

  ### Paramètres
  - id: ID du dresseur (dans l'URL)

  ### Réponse attendue
  - Status: 204 No Content
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("Response body is empty", function() {
    const body = res.getBody();
    expect(body).to.be.oneOf([null, undefined, ""]);
  });
}
