meta {
  name: Get Team - Trainer Not Found
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/trainers/99999/team
  body: none
  auth: none
}

docs {
  Test du cas où on récupère l'équipe d'un dresseur inexistant.

  ### Paramètres
  - trainerId: ID inexistant (99999)

  ### Réponse attendue
  - Status: 404 Not Found
  - Body: Message d'erreur indiquant que le dresseur n'existe pas
}

tests {
  test("Status code is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("Error message is present", function() {
    const body = res.getBody();
    expect(body).to.have.property('message');
    expect(body.message).to.be.a('string');
  });

  test("Error indicates trainer not found", function() {
    const body = res.getBody();
    expect(body.statusCode).to.equal(404);
  });
}

