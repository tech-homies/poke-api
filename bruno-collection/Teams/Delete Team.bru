meta {
  name: Delete Team
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/trainers/1/team
  body: none
  auth: none
}

docs {
  Supprime l'équipe d'un dresseur.

  ### Paramètres
  - trainerId: ID du dresseur (dans l'URL)

  ### Réponse attendue
  - Status: 204 No Content
}

tests {
  test("Status code is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("Response body is empty", function() {
    const body = res.getBody();
    expect(body).to.be.oneOf([null, undefined, ""]);
  });
}

